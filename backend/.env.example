# Copy this file to .env (in the same backend folder) and change values if needed.

# Matches the database in docker-compose.yml
DATABASE_URL=postgresql+psycopg://memorymate:memorymate@localhost:5432/memorymate

# Size of the embedding vectors. Must match the embedding model we pick in Step 4.
# Changing it later means recreating the memories table.
EMBEDDING_DIM=1024

# Secret used to sign login tokens. Change it to any long random text.
# Never share it or commit your .env file to GitHub.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts, in minutes (1440 = 1 day)
JWT_EXPIRE_MINUTES=1440

# Step 3: Google Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model to use. If Google retires it, pick a current "flash" model from
# https://ai.google.dev/gemini-api/docs/models and change only this line.
# Minutes before an unanswered reminder counts as MISSED (60 normally; 2 for quick testing)
MISSED_AFTER_MINUTES=60
GEMINI_MODEL=gemini-3.5-flash-lite
# Step 4b: model that turns memories into vectors for search by meaning
EMBEDDING_MODEL=gemini-embedding-001
# Memory search: ignore memories farther than this in meaning (0 = identical, 1 = unrelated).
# Lower = stricter. Check distances with GET /memories/search?q=...&show_all=true
MAX_MEMORY_DISTANCE=0.5
